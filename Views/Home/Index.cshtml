@{
    DateTime today = DateTime.Now;

    bool isWeekend = today.DayOfWeek == DayOfWeek.Saturday ||
                     today.DayOfWeek == DayOfWeek.Sunday;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Kiểm tra cuối tuần</title>
</head>

<body>

    <h1>Kiểm tra ngày hôm nay</h1>

    <p>
        Hôm nay là:
        <strong>@today.ToString("dd/MM/yyyy")</strong>
    </p>

    @if (isWeekend)
    {
        <h2>Hôm nay là cuối tuần</h2>
    }
    else
    {
        <h2>Hôm nay không phải cuối tuần</h2>
    }

</body>
</html>